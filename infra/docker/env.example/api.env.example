# /opt/rcab/compose/env/api.env — loaded by the api service (docker-compose.prod.yml env_file).
# Every key here is read by apps/api. With NODE_ENV=production the API refuses to
# start if JWT_SECRET or CORS_ORIGINS is missing/invalid, and the Firebase Admin
# provider refuses to start without both FIREBASE_* values.
DATABASE_URL=postgres://rcab:<password>@postgres:5432/rcab

# HS256 signing secret for rcab access tokens. Required; >= 32 bytes, random,
# not a placeholder. Generate with: openssl rand -hex 32
JWT_SECRET=

# Firebase Admin SDK — verifies phone-OTP ID tokens.
# FIREBASE_SERVICE_ACCOUNT_JSON is the service-account key file's JSON on ONE
# line (needs project_id, client_email, private_key).
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Sign-In OAuth client ID (Google link/login audience check).
GOOGLE_CLIENT_ID=<your-google-client-id>

# Browser origin(s) of the web app, comma-separated: https, scheme://host[:port],
# no path, no trailing slash, no "*". One list drives credentialed CORS and the
# CSRF Origin/Referer check on cookie-authenticated /v1/auth routes.
# (ALLOWED_ORIGINS is a deprecated alias; do not set both.)
CORS_ORIGINS=https://app.rcab.example

# >>> business policy — generated by `pnpm policy:doc` from apps/api/src/config/policy/policy.schema.ts; do not edit inside >>>
# Business policy knobs. All optional; each line shows the default. The API validates
# every value (and the cross-field rules) at boot and refuses to start on a bad one.
# Overview, allowed ranges and the decision behind each default: docs/POLICY.md.
#
# ── Pricing & fares ──
# Solo fare flag-fall (base) component. [paise; number ≥ 0]
# FARE_BASE_CENTS=4000
# Solo fare per routed kilometre. [paise/km; number ≥ 0]
# FARE_PER_KM_CENTS=1500
# Solo fare per routed minute. [paise/min; number ≥ 0]
# FARE_PER_MIN_CENTS=200
# Per-seat price multiplier when the pool has 2 seats. [ratio; number 0.01 – 1]
# SEAT_MULTIPLIER_2=0.7
# Per-seat price multiplier when the pool has 3+ seats. [ratio; number 0.01 – 1]
# SEAT_MULTIPLIER_3=0.55
# Platform cut of the gross shared fare; the driver gets the rest. [ratio; number 0 – 1]
# PLATFORM_COMMISSION_RATE=0.2
# Seat count assumed when quoting a shared ride before it is matched. [seats; integer ≥ 2]
# SHARED_QUOTE_SEATS=2
# Lifetime of a signed fare quote token before the client must re-quote. [ms; integer ≥ 1000]
# QUOTE_TTL_MS=300000
# Bound on one OSRM routing call made while pricing (runs inside the join txn). [ms; integer ≥ 1]
# PRICING_OSRM_TIMEOUT_MS=3000
#
# ── Dispatch (normal rides) ──
# Drivers offered in wave 1 (top-K nearest within R1). [drivers; integer ≥ 1]
# DISPATCH_K1=5
# Drivers offered in wave 2 (within R2). [drivers; integer ≥ 1]
# DISPATCH_K2=10
# Wave-1 search radius around the pickup. [m; number ≥ 1]
# DISPATCH_R1_METERS=2000
# Wave-2 (widened) search radius around the pickup. [m; number ≥ 1]
# DISPATCH_R2_METERS=4000
# How long one driver offer stays acceptable (sent to the driver as ttlMs). [ms; integer ≥ 1000]
# DISPATCH_OFFER_TTL_MS=12000
# Normal rides: delay from wave 1 to wave 2. [ms; integer ≥ 1]
# DISPATCH_WAVE_ONE_TIMEOUT_MS=30000
# Normal rides: delay from wave 1 until the ride fails with no driver. [ms; integer ≥ 1]
# DISPATCH_HARD_FAIL_MS=60000
# Geo candidates fetched per wave = K × this + already-offered (before eligibility filtering). [factor; integer ≥ 1]
# DISPATCH_CANDIDATE_HEADROOM=4
# How often the driver current_ride_id Redis projection is rebuilt from Postgres. [ms; integer ≥ 1000]
# DISPATCH_ASSIGNMENT_RECONCILE_MS=30000
#
# ── Scheduled booking ──
# Earliest bookable pickup, measured from now. [ms; integer ≥ 0]
# SCHEDULED_MIN_LEAD_MS=900000
# Latest bookable pickup, measured from now. [ms; integer ≥ 1]
# SCHEDULED_MAX_LEAD_MS=86400000
# Wake a scheduled ride (start dispatch) this long before pickup (T−10). [ms; integer ≥ 0]
# SCHEDULED_WAKE_LEAD_MS=600000
# Scheduled rides: accept/escalation window after wake; unanswered → retried (no cap), never expired. [ms; integer ≥ 1]
# SCHEDULED_DISPATCH_WINDOW_MS=240000
# Scheduled rides: delay from wave 1 to wave 2 inside the window. [ms; integer ≥ 1; default ⌊scheduled.dispatchWindowMs / 2⌋]
# SCHEDULED_DISPATCH_WAVE_ONE_MS=120000
# Wake jobs processed in parallel by one api process. [jobs; integer ≥ 1]
# SCHEDULED_DISPATCH_CONCURRENCY=5
#
# ── Shared-ride matching & pools ──
# An open shared pool closes (timeout) this long after it was opened. [ms; integer ≥ 1]
# MATCHING_POOL_TIMEOUT_MS=60000
# Seats per shared pool. [seats; integer ≥ 1]
# MATCHING_MAX_SEATS=3
# Spatial pre-filter: pool origin AND destination centroids within this distance. [m; number ≥ 1]
# MATCHING_PREFILTER_RADIUS_M=1500
# Max origin / destination detour for a rider to fit a pool. [m; number ≥ 0]
# MATCHING_DETOUR_BUDGET_M=800
# Minimum route-similarity score to join a pool. [score; number 0 – 1]
# MATCHING_SIMILARITY_THRESHOLD=0.7
# Mean route separation at which similarity reaches 0 (s = 1 − d̄/sat). [m; number ≥ 1]
# ROUTE_SIMILARITY_SATURATION_M=1200
#
# ── Ride lifecycle ──
# Driver must wait this long after `arrived` before reporting a no-show. [ms; integer ≥ 0]
# RIDE_NO_SHOW_WAIT_MS=300000
#
# ── Driver presence ──
# How often the auto-offline sweep runs (whole seconds dividing 60; a cron). [ms; integer 1000 – 59000]
# DRIVER_AUTO_OFFLINE_SWEEP_MS=15000
# A driver whose last_seen is older than this is forced offline. [ms; integer ≥ 1000]
# DRIVER_STALE_AFTER_MS=60000
#
# ── Realtime ──
# Min gap between driver_location pushes to a ride room (1 Hz smooth dot). [ms; integer ≥ 0]
# REALTIME_LOCATION_FANOUT_MS=1000
# Min gap between geo-index / last_seen writes per driver. [ms; integer ≥ 0]
# REALTIME_GEO_INDEX_GATE_MS=3000
#
# ── Sessions & auth ──
# Lifetime of an rcab access JWT (returned as expires_in). [s; integer ≥ 60]
# ACCESS_TOKEN_TTL_S=900
# Lifetime of a refresh token (DB expiry and refresh cookie maxAge). [ms; integer ≥ 60000]
# REFRESH_TOKEN_TTL_MS=2592000000
# A just-rotated refresh token reused within this window gets a plain 401, not a family revoke. [s; integer ≥ 0]
# REFRESH_REUSE_GRACE_S=10
# Reject a Firebase ID token whose iat is older than this at exchange. [s; integer ≥ 60]
# FIREBASE_TOKEN_MAX_AGE_S=3600
#
# ── Idempotency ──
# A `pending` create claim older than this may be reclaimed by a retry. [ms; integer ≥ 1000]
# IDEMPOTENCY_PENDING_RECLAIM_MS=60000
#
# ── Rate limits ──
# Default per-client request budget per window (all throttled routes). [requests; integer ≥ 1]
# THROTTLE_GLOBAL_LIMIT=1000
# Window for the default request budget. [ms; integer ≥ 1000]
# THROTTLE_GLOBAL_WINDOW_MS=60000
# Budget for the auth exchange / refresh / logout routes per window. [requests; integer ≥ 1]
# THROTTLE_AUTH_LIMIT=10
# Window for the auth route budget. [ms; integer ≥ 1000]
# THROTTLE_AUTH_WINDOW_MS=60000
#
# ── Outbox relay & reconciler ──
# Outbox relay poll interval (commits also kick it immediately). [ms; integer ≥ 50]
# OUTBOX_RELAY_POLL_MS=1000
# Outbox rows leased per relay tick. [rows; integer ≥ 1]
# OUTBOX_RELAY_BATCH=50
# Lease on a row being published; a crashed publisher is retried after it. [ms; integer ≥ 1000]
# OUTBOX_RELAY_LEASE_MS=30000
# Publish attempts before an outbox row is marked exhausted (reconciler may re-arm). [attempts; integer ≥ 1]
# OUTBOX_MAX_ATTEMPTS=10
# BullMQ attempts for published dispatch-start, pool-expire and scheduled-wake jobs. [attempts; integer ≥ 1]
# OUTBOX_JOB_ATTEMPTS=5
# Base delay of the exponential BullMQ retry backoff for those jobs. [ms; integer ≥ 1]
# OUTBOX_JOB_BACKOFF_MS=1000
# How often the dispatch reconciler rebuilds missing work from Postgres (also on boot). [ms; integer ≥ 1000]
# OUTBOX_RECONCILE_INTERVAL_MS=300000
# Trips touched more recently than this are skipped (likely mid-flight). [ms; integer ≥ 0]
# OUTBOX_RECONCILE_GRACE_MS=15000
# Upper bound of trips inspected per reconcile query. [trips; integer ≥ 1]
# OUTBOX_RECONCILE_MAX_PER_PASS=500
#
# ── Observability sampling ──
# How often the gauges sampled from Postgres / Redis (active + busy drivers, outbox backlog, match rate) refresh. [ms; integer ≥ 1000]
# METRICS_SAMPLE_INTERVAL_MS=15000
# Rolling window of closed pools behind rcab_shared_match_rate (riders who shared a ride / riders in pools that closed). [ms; integer ≥ 60000]
# METRICS_MATCH_RATE_WINDOW_MS=900000
#
# ── Performance budget (load-test gates) ──
# Load-test gate: API p95 latency across the exercised scenarios. Not read by the running API. [ms; integer ≥ 1]
# PERF_BUDGET_API_P95_MS=400
# Load-test gate: API p99 latency across the exercised scenarios. Not read by the running API. [ms; integer ≥ 1]
# PERF_BUDGET_API_P99_MS=800
# Load-test gate: POST /v1/rides/quote p95 (local OSRM). [ms; integer ≥ 1]
# PERF_BUDGET_QUOTE_P95_MS=250
# Load-test gate: ride create -> first ride_offer received by a simulated driver, p95. [ms; integer ≥ 1]
# PERF_BUDGET_DISPATCH_P95_MS=3000
# Load-test gate (error budget): share of HTTP responses that may be 5xx. [ratio; number 0 – 1]
# PERF_BUDGET_ERROR_RATE_5XX=0.005
# Load-test gate: share of quote / ride-create / location operations that must SUCCEED (a fast 409 or 503 storm is not capacity). [ratio; number 0 – 1]
# PERF_BUDGET_MIN_BUSINESS_SUCCESS=0.99
# Load-test driver location cadence per simulated driver; mirrors the driver app foreground task. [ms; integer ≥ 100]
# PERF_BUDGET_DRIVER_LOCATION_INTERVAL_MS=5000
# <<< business policy <<<
