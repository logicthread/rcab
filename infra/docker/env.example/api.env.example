# /opt/rcab/compose/env/api.env — loaded by the api service (docker-compose.prod.yml env_file).
# Every key here is read by apps/api. With NODE_ENV=production the API refuses to
# start if JWT_SECRET or CORS_ORIGINS is missing/invalid, and the Firebase Admin
# provider refuses to start without both FIREBASE_* values.
DATABASE_URL=postgres://rcab:<password>@postgres:5432/rcab

# HS256 signing secret for rcab access tokens. Required; >= 32 bytes, random,
# not a placeholder. Generate with: openssl rand -hex 32
JWT_SECRET=

# Firebase Admin SDK — verifies phone-OTP ID tokens.
# FIREBASE_SERVICE_ACCOUNT_JSON is the service-account key file's JSON on ONE
# line (needs project_id, client_email, private_key).
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Sign-In OAuth client ID (Google link/login audience check).
GOOGLE_CLIENT_ID=<your-google-client-id>

# Browser origin(s) of the web app, comma-separated: https, scheme://host[:port],
# no path, no trailing slash, no "*". One list drives credentialed CORS and the
# CSRF Origin/Referer check on cookie-authenticated /v1/auth routes.
# (ALLOWED_ORIGINS is a deprecated alias; do not set both.)
CORS_ORIGINS=https://app.rcab.example

# Scheduled-booking accept/escalation window (ms), after the wake. Feature note
# [[features-scheduled-booking]] specifies 4 minutes; normal rides keep their own
# DISPATCH_* timing (30 s wave 1, 60 s hard-fail). At the end of the window an
# unanswered scheduled ride is RETRIED under a fresh generation (no retry cap),
# never expired. Positive integer; optional.
# SCHEDULED_DISPATCH_WINDOW_MS=240000
# Delay before wave 2 (wider radius) within that window; integer in
# [1, SCHEDULED_DISPATCH_WINDOW_MS]. Defaults to half the window.
# SCHEDULED_DISPATCH_WAVE_ONE_MS=120000
