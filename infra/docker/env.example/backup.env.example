# /opt/rcab/compose/env/backup.env   (placeholders only; never commit real values)
#
# Default behaviour: nightly encrypted pg_dump -Fc into the local volume
# /opt/rcab/backups; newest 30 plus the oldest of each of the last 12 months kept.
# Offsite is OFF until RCLONE_REMOTE is set. See docs/operations/recovery-runbook.md.

# --- Postgres connection (compose supplies PGHOST=postgres, PGPORT=5432) ------
PGUSER=rcab
PGDB=rcab
# Must equal POSTGRES_PASSWORD in postgres.env, otherwise pg_dump cannot authenticate.
PGPASSWORD=<same-as-POSTGRES_PASSWORD>

# --- Encryption ------------------------------------------------------------------
# /opt/rcab/secrets/age.key (mounted at /run/secrets/age.key) must contain the PUBLIC
# recipient line(s) (age1...), NOT the private identity. Create the pair elsewhere:
#   age-keygen -o rcab-backup.identity     # keep the identity off the VPS (see runbook)
#   age-keygen -y rcab-backup.identity > /opt/rcab/secrets/age.key
# The backup refuses to run without it unless you explicitly allow plaintext (dev only):
# BACKUP_ALLOW_PLAINTEXT=1

# --- Local retention ---------------------------------------------------------------
# BACKUP_KEEP_DAILY=30
# BACKUP_KEEP_MONTHLY=12
# BACKUP_MIN_FREE_MB=1024
# BACKUP_RUN_ON_START=1        # also take one backup when the container starts

# --- Optional offsite (any S3-compatible store; no vendor is required) ---------------
# The remote is defined purely by environment variables, no rclone.conf:
# RCLONE_REMOTE=offsite
# RCLONE_BUCKET=rcab-backups
# RCLONE_PREFIX=rcab
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example.invalid
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=<access-key-id>
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=<secret-access-key>
# RCLONE_KEEP_DAILY_DAYS=30
# RCLONE_PRUNE=1               # delete offsite objects older than the retention window
