# Place this as /opt/rcab/compose/.env (deploy.sh passes it via --env-file).
# These vars are interpolated by Docker Compose itself (not passed into containers).
REDIS_PASSWORD=<strong-password>

# Release identity (RCAB-E8.S11). scripts/deploy/deploy.sh OWNS this line: it
# rewrites RCAB_VERSION to the commit SHA being released and records the previous
# value in RCAB_PREVIOUS_VERSION for rollback. Do not edit by hand during a release.
RCAB_VERSION=<commit-sha-of-first-release>
# RCAB_PREVIOUS_VERSION=            # written by deploy.sh
# Image namespace; images are <RCAB_REGISTRY>/rcab-api:<sha> and rcab-web:<sha>.
# RCAB_REGISTRY=ghcr.io/logicthread

# Public web configuration is NOT set here any more. Next.js inlines NEXT_PUBLIC_*
# into the browser bundle at IMAGE BUILD time, so the Jenkins build stage supplies
# them as Dockerfile build args (Jenkins job/folder environment variables; public
# values only) and they become part of the web image identity. Changing them means
# building a new web image, i.e. a new release.
#
# Sign-in is Google-only until launch (RCAB-E8.S15). The web image needs
# NEXT_PUBLIC_API_URL only; the browser gets the enabled methods and the Google
# client id from the API (GET /v1/auth/config, configured by GOOGLE_CLIENT_IDS in
# api.env). NEXT_PUBLIC_GOOGLE_CLIENT_ID is an optional build-time fallback. The
# NEXT_PUBLIC_FIREBASE_* values are required ONLY for a build with
# WEB_AUTH_PHONE_ENABLED=true (phone OTP re-enabled via AUTH_ENABLED_METHODS).
