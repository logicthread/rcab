# Place this as .env next to docker-compose.prod.yml (or at /opt/rcab/compose/.env)
# These vars are interpolated by Docker Compose itself (not passed into containers).
REDIS_PASSWORD=<strong-password>

# Public web configuration. Next.js inlines NEXT_PUBLIC_* into the browser bundle
# at IMAGE BUILD time, so these are passed as build args to the web image
# (docker-compose.prod.yml -> web.build.args). Changing them requires rebuilding
# the web image. They are public: never put a server secret here.
# Required (the build fails if empty; API URL must not be localhost):
NEXT_PUBLIC_API_URL=https://api.<your-domain>
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<firebase-project-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<firebase-web-app-id>
# Optional (defaults to the public OSM Nominatim instance):
# NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
