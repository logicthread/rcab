FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0 AS base

ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable \
  && corepack prepare pnpm@10.33.4 --activate

FROM base AS deps

WORKDIR /workspace

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/api-client/package.json ./packages/api-client/

RUN pnpm install --frozen-lockfile

FROM base AS build

WORKDIR /workspace

COPY --from=deps /workspace ./
COPY packages ./packages
COPY apps/web ./apps/web

# Next.js inlines NEXT_PUBLIC_* into the client bundle at `next build` time;
# setting them on the running container has no effect (F13). They are PUBLIC
# values (never put a server secret here) and become part of the image identity.
#
# Sign-in is Google-only until launch (RCAB-E8.S15): the browser asks the API
# (GET /v1/auth/config) which methods are on and gets the Google client id from
# it, so no Firebase value is needed. Phone OTP stays in the code behind the
# policy flag `auth.enabledMethods`; build with WEB_AUTH_PHONE_ENABLED=true to
# make the NEXT_PUBLIC_FIREBASE_* values mandatory again (while the OTP provider
# is still Firebase).
ARG NEXT_PUBLIC_API_URL
ARG WEB_AUTH_PHONE_ENABLED=false
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ARG NEXT_PUBLIC_FIREBASE_API_KEY=
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID=
ARG NEXT_PUBLIC_FIREBASE_APP_ID=
ARG NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID \
    NEXT_PUBLIC_FIREBASE_API_KEY=$NEXT_PUBLIC_FIREBASE_API_KEY \
    NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN \
    NEXT_PUBLIC_FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID \
    NEXT_PUBLIC_FIREBASE_APP_ID=$NEXT_PUBLIC_FIREBASE_APP_ID \
    NEXT_PUBLIC_NOMINATIM_URL=$NEXT_PUBLIC_NOMINATIM_URL

# Fail the build rather than ship a bundle pointing at localhost, or (only when
# phone sign-in is enabled for this build) a blank Firebase app.
RUN if [ -z "$NEXT_PUBLIC_API_URL" ]; then \
      echo "build-arg NEXT_PUBLIC_API_URL is required for the production web image" >&2; exit 1; \
    fi; \
    case "$NEXT_PUBLIC_API_URL" in \
      *localhost*|*127.0.0.1*) echo "NEXT_PUBLIC_API_URL must not point at localhost" >&2; exit 1;; \
    esac; \
    case "$WEB_AUTH_PHONE_ENABLED" in \
      true) \
        for v in NEXT_PUBLIC_FIREBASE_API_KEY NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN \
                 NEXT_PUBLIC_FIREBASE_PROJECT_ID NEXT_PUBLIC_FIREBASE_APP_ID; do \
          eval "val=\$$v"; \
          if [ -z "$val" ]; then echo "build-arg $v is required when WEB_AUTH_PHONE_ENABLED=true" >&2; exit 1; fi; \
        done;; \
      false) ;; \
      *) echo "WEB_AUTH_PHONE_ENABLED must be true or false" >&2; exit 1;; \
    esac

RUN pnpm --filter @rcab/shared --filter @rcab/api-client build \
  && pnpm --filter @rcab/web build

FROM base AS deploy

WORKDIR /workspace

COPY --from=build /workspace ./

RUN pnpm --filter @rcab/web deploy /deploy --prod --legacy

COPY --from=build /workspace/apps/web/.next /deploy/.next
COPY --from=build /workspace/apps/web/public /deploy/public

FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0 AS production

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd -r rcab && useradd -r -g rcab rcab

WORKDIR /app

COPY --from=deploy /deploy ./

# Build identity (RCAB-E8.S11). Declared LAST (cache-friendly). The version is
# served as a static file at /version.json so a deploy can assert what is running
# without executing the app; `next start` serves public/ from the working dir.
ARG RCAB_VERSION=dev
ARG RCAB_BUILT_AT=unknown
RUN printf '{"version":"%s","builtAt":"%s"}\n' "$RCAB_VERSION" "$RCAB_BUILT_AT" > public/version.json
LABEL org.opencontainers.image.revision=$RCAB_VERSION \
      org.opencontainers.image.created=$RCAB_BUILT_AT \
      org.opencontainers.image.title="rcab-web" \
      org.opencontainers.image.source="https://github.com/logicthread/rcab"

USER rcab

EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000

CMD ["./node_modules/.bin/next", "start"]
