# Nightly at 21:00 UTC = 02:30 IST. busybox crond does not pass the container
# environment, so the job sources the snapshot written by entrypoint.sh.
# Output goes to PID 1's stdout so `docker compose logs backup` shows it.
0 21 * * * . /etc/backup-env.sh; /usr/local/bin/backup.sh > /proc/1/fd/1 2>&1
