FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0 AS base

ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable \
  && corepack prepare pnpm@10.33.4 --activate

FROM base AS deps

WORKDIR /workspace

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/test-fixtures/package.json ./packages/test-fixtures/

RUN pnpm install --frozen-lockfile

FROM base AS build

WORKDIR /workspace

COPY --from=deps /workspace ./
COPY packages ./packages
COPY apps/api ./apps/api

# `pnpm build` copies the Lua assets next to the compiled services (F03);
# check-artifact fails the image build if they are missing or unreadable.
RUN pnpm --filter @rcab/shared --filter @rcab/api-client build \
  && pnpm --filter @rcab/api build \
  && node apps/api/scripts/check-artifact.mjs

FROM base AS deploy

WORKDIR /workspace

COPY --from=build /workspace ./

RUN pnpm --filter @rcab/api deploy /deploy --prod --legacy

COPY --from=build /workspace/apps/api/dist /deploy/dist
COPY --from=build /workspace/apps/api/migrations /deploy/migrations

FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0 AS production

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd -r rcab && useradd -r -g rcab rcab

WORKDIR /app

COPY --from=deploy /deploy ./

# Build identity (RCAB-E8.S11). Declared LAST so a new commit/timestamp only
# invalidates the final cheap layers, never the dependency/compile stages.
# The image is built once per commit and promoted by tag; GET /v1/health/version
# returns these values so a deploy can assert what is actually running.
ARG RCAB_VERSION=dev
ARG RCAB_BUILT_AT=unknown
ENV RCAB_VERSION=$RCAB_VERSION \
    RCAB_BUILT_AT=$RCAB_BUILT_AT
LABEL org.opencontainers.image.revision=$RCAB_VERSION \
      org.opencontainers.image.created=$RCAB_BUILT_AT \
      org.opencontainers.image.title="rcab-api" \
      org.opencontainers.image.source="https://github.com/logicthread/rcab"

USER rcab

EXPOSE 3000

CMD ["node", "dist/main.js"]
