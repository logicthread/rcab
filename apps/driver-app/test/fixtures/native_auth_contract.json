{
  "firebase_exchange": {
    "method": "POST",
    "path": "/v1/auth/native/firebase-exchange",
    "request": { "id_token": "firebase.id.token" },
    "response_200": {
      "access_token": "access.jwt.one",
      "token_type": "bearer",
      "expires_in": 900,
      "refresh_token": "refresh-one",
      "user": {
        "id": "11111111-1111-4111-8111-111111111111",
        "role": "driver",
        "phone_e164": "+233201234567"
      }
    }
  },
  "refresh": {
    "method": "POST",
    "path": "/v1/auth/native/refresh",
    "request": { "refresh_token": "refresh-one" },
    "response_200": {
      "access_token": "access.jwt.two",
      "token_type": "bearer",
      "expires_in": 900,
      "refresh_token": "refresh-two",
      "user": {
        "id": "11111111-1111-4111-8111-111111111111",
        "role": "driver",
        "phone_e164": "+233201234567"
      }
    },
    "reuse_status": 401
  },
  "logout": {
    "method": "POST",
    "path": "/v1/auth/native/logout",
    "headers": { "Authorization": "Bearer access.jwt.one" },
    "request": { "refresh_token": "refresh-one" },
    "response_status": 204
  }
}
