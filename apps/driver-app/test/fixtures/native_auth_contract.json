{
  "firebase_exchange": {
    "method": "POST",
    "path": "/v1/auth/native/firebase-exchange",
    "request": {
      "id_token": "firebase.id.token"
    },
    "response_200": {
      "access_token": "access.jwt.one",
      "token_type": "bearer",
      "expires_in": 900,
      "refresh_token": "refresh-one",
      "user": {
        "id": "11111111-1111-4111-8111-111111111111",
        "role": "driver",
        "phone_e164": "+233201234567",
        "email": null
      }
    }
  },
  "google": {
    "method": "POST",
    "path": "/v1/auth/native/google",
    "request": {
      "id_token": "google.id.token"
    },
    "response_200": {
      "access_token": "access.jwt.google",
      "token_type": "bearer",
      "expires_in": 900,
      "refresh_token": "refresh-google",
      "user": {
        "id": "22222222-2222-4222-8222-222222222222",
        "role": "client",
        "phone_e164": null,
        "email": "driver@example.com"
      }
    }
  },
  "config": {
    "method": "GET",
    "path": "/v1/auth/config",
    "response_200": {
      "methods": [
        "google"
      ],
      "google": {
        "clientId": "123-web.apps.googleusercontent.com"
      }
    }
  },
  "refresh": {
    "method": "POST",
    "path": "/v1/auth/native/refresh",
    "request": {
      "refresh_token": "refresh-one"
    },
    "response_200": {
      "access_token": "access.jwt.two",
      "token_type": "bearer",
      "expires_in": 900,
      "refresh_token": "refresh-two",
      "user": {
        "id": "11111111-1111-4111-8111-111111111111",
        "role": "driver",
        "phone_e164": "+233201234567",
        "email": null
      }
    },
    "reuse_status": 401
  },
  "logout": {
    "method": "POST",
    "path": "/v1/auth/native/logout",
    "headers": {},
    "request": {
      "refresh_token": "refresh-one"
    },
    "response_status": 204
  },
  "error_codes": {
    "google_token_invalid": 401,
    "google_email_unverified": 403,
    "google_not_configured": 503,
    "auth_method_disabled": 403,
    "account_disabled": 403
  }
}
