{
  "description": "Native (mobile) session contract for /v1/auth/native/*. No cookies, no CSRF: the refresh token travels in JSON and must be kept in secure storage. Every successful refresh rotates it; the previous value is single-use and presenting it again revokes the whole session. Asserted by apps/api/src/modules/auth/auth.controller.spec.ts and test/integration/auth.int.spec.ts.",
  "version": 1,
  "endpoints": {
    "firebase_exchange": {
      "method": "POST",
      "path": "/v1/auth/native/firebase-exchange",
      "request": {
        "headers": { "Content-Type": "application/json" },
        "body": { "id_token": "<firebase-phone-auth-id-token>" }
      },
      "response": {
        "status": 200,
        "body": {
          "access_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIzZjJjOWI0ZS0xYzJhLTRkNWUtOGY5MC0xMjM0NTY3ODlhYmMiLCJyb2xlIjoiZHJpdmVyIiwiYXV0aF9tZXRob2QiOiJwaG9uZSIsInR5cCI6ImFjY2VzcyJ9.signature",
          "token_type": "bearer",
          "expires_in": 900,
          "refresh_token": "q8Vh0hY3m9wq2bS1nJp4c7tXzA6eRkLdUoF5gNiHvBs",
          "user": {
            "id": "3f2c9b4e-1c2a-4d5e-8f90-123456789abc",
            "role": "driver",
            "phone_e164": "+919876543210"
          }
        }
      }
    },
    "refresh": {
      "method": "POST",
      "path": "/v1/auth/native/refresh",
      "request": {
        "headers": { "Content-Type": "application/json" },
        "body": { "refresh_token": "q8Vh0hY3m9wq2bS1nJp4c7tXzA6eRkLdUoF5gNiHvBs" }
      },
      "response": {
        "status": 200,
        "body": {
          "access_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIzZjJjOWI0ZS0xYzJhLTRkNWUtOGY5MC0xMjM0NTY3ODlhYmMiLCJyb2xlIjoiZHJpdmVyIiwiYXV0aF9tZXRob2QiOiJwaG9uZSIsInR5cCI6ImFjY2VzcyJ9.signature",
          "token_type": "bearer",
          "expires_in": 900,
          "refresh_token": "OqELf-qUYjiWzhUJIQie43SpezX8MVBEW9cBuSNDeEE",
          "user": {
            "id": "3f2c9b4e-1c2a-4d5e-8f90-123456789abc",
            "role": "driver",
            "phone_e164": "+919876543210"
          }
        }
      }
    },
    "logout": {
      "method": "POST",
      "path": "/v1/auth/native/logout",
      "request": {
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer <access_token>"
        },
        "body": { "refresh_token": "OqELf-qUYjiWzhUJIQie43SpezX8MVBEW9cBuSNDeEE" }
      },
      "response": { "status": 204, "body": null }
    }
  },
  "errors": {
    "invalid_request": {
      "status": 400,
      "when": "id_token / refresh_token missing or not a string"
    },
    "invalid_firebase_token": {
      "status": 401,
      "body": { "error": { "code": "invalid_firebase_token", "message": "Firebase token verification failed", "request_id": "<x-request-id>" } }
    },
    "invalid_refresh_token": {
      "status": 401,
      "when": "unknown, expired, already used, or revoked; reusing a consumed token also revokes every token of that session — sign in again",
      "body": { "error": { "code": "invalid_refresh_token", "message": "Refresh token is invalid, expired, or already used", "request_id": "<x-request-id>" } }
    },
    "account_disabled_on_refresh": {
      "status": 401,
      "body": { "error": { "code": "account_disabled", "message": "Account is not active", "request_id": "<x-request-id>" } }
    },
    "account_disabled_on_exchange": {
      "status": 403,
      "body": { "error": { "code": "account_disabled", "message": "Account is not active", "request_id": "<x-request-id>" } }
    },
    "unauthorized": {
      "status": 401,
      "when": "logout without a valid Bearer access token",
      "body": { "error": { "code": "unauthorized", "message": "Invalid or expired token", "request_id": "<x-request-id>" } }
    },
    "rate_limited": {
      "status": 429,
      "when": "more than 10 firebase-exchange calls per minute per client",
      "body": { "error": { "code": "rate_limited", "message": "ThrottlerException: Too Many Requests", "request_id": "<x-request-id>" } }
    }
  }
}
