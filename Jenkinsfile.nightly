// Nightly e2e + load. OWNS the stack it tests (RCAB-E8.S11, F14): brings up an
// isolated compose project, migrates, seeds, waits for readiness, runs the suites,
// archives diagnostics, and always tears the project (and its volumes) down.
//
// The dev compose publishes fixed host ports (api 3000, web 3002, postgres 55432,
// redis 6379), so this job must run on a CI worker, NOT on the live VPS. The
// 'Preflight' stage refuses to run if any of those ports is already listening
// rather than clobbering or load-testing something else.
pipeline {
    agent any

    triggers {
        cron('H 2 * * *')
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
    }

    environment {
        // Own project name: nothing else on the worker is touched, `down -v` is scoped to it.
        // scripts/seed-dev.sh and docker compose honour COMPOSE_PROJECT_NAME over the file's name.
        COMPOSE_PROJECT_NAME = 'rcab-nightly'
        DEV_SMOKE_URL = 'http://localhost:3000/'
        DEV_SMOKE_TIMEOUT = '240'
        E2E_BASE_URL = 'http://localhost:3002'
        E2E_API_URL = 'http://localhost:3000'
        CI = '1'
    }

    stages {
        stage('Install') {
            steps {
                sh 'pnpm install --frozen-lockfile'
                sh 'pnpm --filter @rcab/web exec playwright install chromium'
            }
        }

        stage('Preflight') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -eu
                    for port in 3000 3002 55432 6379; do
                        if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
                            echo "port $port already in use on this worker; refusing to start the nightly stack" >&2
                            exit 1
                        fi
                    done
                '''
            }
        }

        stage('Start stack') {
            steps {
                // Same compose file the e2e suite is written against (no obs profile).
                sh '''
                    set -eu
                    test -f .env.dev || cp .env.dev.example .env.dev
                    docker compose --env-file .env.dev -f infra/docker/docker-compose.dev.yml up -d --build
                    bash scripts/dev-smoke.sh
                    docker compose --env-file .env.dev -f infra/docker/docker-compose.dev.yml exec -T api npx tsx src/migrate.ts
                    bash scripts/seed-dev.sh --reset
                    curl -fsS http://localhost:3002/ -o /dev/null
                '''
            }
        }

        stage('E2E tests') {
            steps {
                sh 'pnpm test:e2e'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'apps/web/test-results/**,apps/web/playwright-report/**', allowEmptyArchive: true
                }
            }
        }

        stage('Load tests') {
            steps {
                // Targets the stack started above (API_BASE defaults to http://localhost:3000).
                sh 'pnpm test:load'
            }
        }
    }

    post {
        always {
            // Diagnostics BEFORE teardown; neither step can mask a failed stage.
            sh '''
                docker compose --env-file .env.dev -f infra/docker/docker-compose.dev.yml ps > nightly-compose-ps.txt 2>&1 || true
                docker compose --env-file .env.dev -f infra/docker/docker-compose.dev.yml logs --no-color --tail=500 > nightly-compose.log 2>&1 || true
            '''
            archiveArtifacts artifacts: 'nightly-compose-ps.txt,nightly-compose.log', allowEmptyArchive: true
            sh 'docker compose --env-file .env.dev -f infra/docker/docker-compose.dev.yml down -v --remove-orphans || true'
            cleanWs()
        }
        failure {
            echo "Nightly run FAILED — ${env.BUILD_URL}"
            // TODO RCAB-E1.S5: open Linear issue via Linear API when integration is available
        }
    }
}
