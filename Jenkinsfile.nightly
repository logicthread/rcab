pipeline {
    agent any

    triggers {
        cron('H 2 * * *')
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
    }

    stages {
        stage('Install') {
            steps {
                sh 'pnpm install --frozen-lockfile'
            }
        }

        stage('E2E tests') {
            steps {
                sh 'pnpm test:e2e'
            }
        }

        stage('Load tests') {
            steps {
                sh 'pnpm test:load'
            }
        }

        // RCAB-E8.S3: monthly (1st, UTC) end-to-end rehearsal of the backup image and the
        // restore drill on fixture data. Secret-free: throwaway containers, a freshly
        // generated age key, a local-backend rclone remote. The restore drill against REAL
        // backups needs the age identity and is a separate operator cron: see
        // docs/operations/recovery-runbook.md section 3.
        stage('Backup + restore rehearsal (monthly)') {
            when {
                expression { return sh(returnStdout: true, script: 'date -u +%d').trim() == '01' }
            }
            steps {
                sh 'scripts/recovery/backup-rehearsal.sh'
                sh 'scripts/recovery/redis-loss-drill.sh'
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        failure {
            echo "Nightly run FAILED — ${env.BUILD_URL}"
            // TODO RCAB-E1.S5: open Linear issue via Linear API when integration is available
        }
    }
}
